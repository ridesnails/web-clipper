/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "web-clipper",
	"main": "src/index.js",
	"compatibility_date": "2026-03-10",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	"vars": {
		"DEFUDDLE_FALLBACK": "true",
		"IMAGE_PROXY_LIMIT": "20"
	},
	"ai": {
		"binding": "AI"
	},
	"browser": {
		"binding": "BROWSER"
	},
	/**
	 * KV namespace for clip idempotency records (url → {fnsPath, telegraphPath, telegraphUrl}).
	 * Created via `wrangler kv namespace create CLIP_KV`.
	 */
	"kv_namespaces": [
		{
			"binding": "CLIP_KV",
			"id": "799ed8d6a14846029c2e2a6c761e4f92"
		}
	],
	/**
	 * Durable Object for concurrent same-URL clip mutual exclusion (phase 4B).
	 * SQLite-backed (:new_sqlite_classes) — works on Free plan.
	 */
	"durable_objects": {
		"bindings": [
			{
				"name": "CLIP_LOCK",
				"class_name": "ClipLock"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"ClipLock"
			]
		}
	],
	/**
	 * Workflow for async clip jobs (phase 4C): client POSTs /json-async, engine
	 * runs the full clip chain server-side (survives client disconnects), client
	 * polls /clip-status. Deploy requires the account to support Workflows.
	 */
	"workflows": [
		{
			"name": "web-clipper-clip",
			"binding": "CLIP_WORKFLOW",
			"class_name": "ClipWorkflow"
		}
	]
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
