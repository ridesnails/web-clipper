{
  "afterToolCall": [
    {
      "matcher": "terminal-execute",
      "description": "Send notification after terminal commands",
      "hooks": [
        {
          "type": "command",
          "command": "osascript -e 'display notification \"终端命令执行完成\" with title \"Snow CLI\"'",
          "enabled": true
        }
      ]
    }
  ]
}
